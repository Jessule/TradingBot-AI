rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // one save per player, readable and writable only by that player
    match /saves/{uid} {
      allow read, delete: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['name', 'data', 'lifetime', 'updated'])
        && request.resource.data.name is string && request.resource.data.name.size() <= 16
        && request.resource.data.data is string && request.resource.data.data.size() < 100000
        && request.resource.data.lifetime is number
        && request.resource.data.updated is timestamp;
    }
  }
}
